# Supabase — Project Settings > API Keys
# 새 키(sb_publishable_/sb_secret_)와 예전 키(anon/service_role) 둘 다 동작
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # publishable 키 (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=        # secret 키 (sb_secret_...). 서버 전용, 클라이언트 노출 금지

# Cloudflare TURN — dash.cloudflare.com > Realtime > TURN 앱 생성
# 서버에서 단기 credential을 발급해 클라이언트에 내려준다 (키 자체는 서버 전용)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# 운영 알림 (OPS-06·07) — Vercel Production에만 넣는다. 셋 다 비밀값: 실제 값을 커밋하지 말 것
# 디스코드 채널 → 편집 → 연동 → 웹후크 → URL 복사
DISCORD_WEBHOOK_INFO=             # 평소 알림 (연결 실패 한 건, TURN 없이 시작, 화면 오류, 하루 요약) — 채널 알림 꺼 둠
DISCORD_WEBHOOK_ALERT=            # 응급 알림 (TURN 설정 오류, 실패 몰림, DB 조회·기록 실패)
CRON_SECRET=                      # 하루 요약(/api/cron/digest) 호출 비밀값. openssl rand -hex 32

# 선택
# NEXT_PUBLIC_SITE_URL=https://...  # 알림 속 상담 링크 주소 (없으면 Vercel 운영 주소)
# ALERTS_ENABLED=1                  # 운영이 아닌 곳에서도 알림을 보내 시험할 때만
