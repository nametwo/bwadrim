# Supabase — Project Settings > API Keys
# 새 키(sb_publishable_/sb_secret_)와 예전 키(anon/service_role) 둘 다 동작
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # publishable 키 (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=        # secret 키 (sb_secret_...). 서버 전용, 클라이언트 노출 금지

# 서비스 주소 (OPS-07). 고객에게 보내는 링크와 카톡 카드 사진 주소를 늘 이 주소로 만든다.
# 비우면 엔지니어가 지금 연 주소(host)로 만든다 — 로컬·미리보기는 비워 둔다. 운영에는 https://bwadrim.com
# NEXT_PUBLIC_이라 빌드할 때 들어간다 — 넣거나 바꾸면 Redeploy
NEXT_PUBLIC_SITE_URL=

# Cloudflare TURN — dash.cloudflare.com > Realtime > TURN 앱 생성
# 서버에서 단기 credential을 발급해 클라이언트에 내려준다 (키 자체는 서버 전용)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# 카카오링크 — developers.kakao.com > 앱 > 플랫폼 키 > JavaScript 키 (공개용, 클라이언트에 노출돼도 됨)
# 같은 화면의 JavaScript SDK 도메인에 서비스 주소·http://localhost:3000 등록, 앱 > 제품 링크 관리 > 웹 도메인에도 서비스 주소 등록.
# 비우면 '카톡 보내기' 버튼만 숨겨진다 (ROOM-14)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 카톡 전송 웹훅 확인·상담 id 서명용 — 같은 앱 > 어드민 키에서 '대표' 표시가 붙은 키. 서버 전용, 클라이언트 노출 금지 (ROOM-15·16)
# 앱 > 웹훅 > 카카오톡 공유 웹훅에 https://서비스 주소/api/kakao/share-webhook (POST) 등록. 비우면 웹훅을 받지 않는다
KAKAO_ADMIN_KEY=

# 디스코드 알림 (OPS-09) — 디스코드 채널 설정 > 연동 > 웹훅에서 만든 주소. 서버 전용. 둘 다 (선택)
# 응급: 지금 봐야 하는 것(연결 실패, 카메라는 켰는데 연결 없이 끝남, TURN 발급 실패·상한, DB 기록 실패, 로그인 서버 장애)
# 일반: 상담이 흘러가는 단계마다 한 줄(만듦, 링크 엶, 카메라 켬·못 켬, 연결, 연결 실패, 끝남, 카톡 전송). 비우면 그 채널로는 보내지 않는다.
# 둘 다 운영(Production)에만 넣는다 — 미리보기 배포가 운영 채널에 글을 보내지 않게
DISCORD_WEBHOOK_URGENT=
DISCORD_WEBHOOK_GENERAL=
